 void XmaContext::ClearLocked(XMA_CONTEXT_DATA* data) {
+  if (REXCVAR_GET(xma_trace)) {
+    REXAPU_INFO("[xma] ctx {} clear (buf0={} buf1={} cur={} rd={})", id(),
+                uint32_t(data->input_buffer_0_valid), uint32_t(data->input_buffer_1_valid),
