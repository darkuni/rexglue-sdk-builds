-  ResetDecoderState();
+  if (REXCVAR_GET(xma_flush_decoder_on_clear)) {
+    ResetDecoderState();
+  } else {
+    // Match Xenia: reset bookkeeping only and keep the decoder's MDCT overlap,
+    // so a context cleared and refilled to repeat/stream a sound stays seamless.
+    // Release() still does the full reset for a context handed to a new sound.
+    raw_frame_.fill(0);
+    current_frame_remaining_subframes_ = 0;
+    loop_frame_output_limit_ = 0;
+    loop_start_skip_pending_ = false;
