+REXCVAR_DEFINE_BOOL(xma_trace, false, "Audio",
+                    "Log XMA context setup (buffers, loop registers) when it changes, and loop-end "
+                    "positions the decoder steps over without looping (diagnostics only)");
+
+REXCVAR_DEFINE_BOOL(xma_honor_stream_skip, true, "Audio",
+                    "Drop the encoder-delay / end-padding samples marked in XMA frame headers "
+                    "(start/end skip), as the console's XMA hardware does. Fixes the click at "
+                    "every pass of buffer-resubmitted loops (e.g. OutRun's engine sounds).");
+
 namespace rex::audio {
 
+namespace {
+struct TraceState {
+  uint32_t sig[10] = {};
+  bool valid = false;
+};
+std::array<TraceState, 320> g_xma_trace_state;
+}  // namespace
+
 using stream::BitStream;
 
 const uint32_t XmaContext::kBitsPerPacketHeader;
@@ -104,6 +125,28 @@ bool XmaContext::Work() {
   XMA_CONTEXT_DATA data(context_ptr);
   const XMA_CONTEXT_DATA initial_data = data;
 
+  if (REXCVAR_GET(xma_trace) && id() < g_xma_trace_state.size()) {
+    const uint32_t sig[10] = {uint32_t(data.loop_count),        uint32_t(data.loop_start),
+                              uint32_t(data.loop_end),          uint32_t(data.loop_subframe_end),
+                              uint32_t(data.loop_subframe_skip), uint32_t(data.input_buffer_0_ptr),
+                              uint32_t(data.input_buffer_0_packet_count),
+                              uint32_t(data.input_buffer_1_ptr),
+                              uint32_t(data.input_buffer_1_packet_count),
+                              uint32_t(data.sample_rate)};
+    auto& st = g_xma_trace_state[id()];
+    if (!st.valid || std::memcmp(st.sig, sig, sizeof(sig)) != 0) {
+      std::memcpy(st.sig, sig, sizeof(sig));
+      st.valid = true;
+      REXAPU_INFO(
+          "[xma] ctx {} cfg loop_count={} loop_start={} loop_end={} sf_end={} sf_skip={} "
+          "in0={:08X}x{} in1={:08X}x{} rate={} stereo={} rd={} v0={} v1={} cur={} sdc={}",
+          id(), sig[0], sig[1], sig[2], sig[3], sig[4], sig[5], sig[6], sig[7], sig[8], sig[9],
+          uint32_t(data.is_stereo), uint32_t(data.input_buffer_read_offset),
+          uint32_t(data.input_buffer_0_valid), uint32_t(data.input_buffer_1_valid),
+          uint32_t(data.current_buffer), uint32_t(data.subframe_decode_count));
+    }
+  }
+
   if (!data.output_buffer_valid) {
     return true;
   }
@@ -239,6 +282,10 @@ void XmaContext::UpdateLoopStatus(XMA_CONTEXT_DATA* data) {
     return;
   }
 
+  if (REXCVAR_GET(xma_trace)) {
+    REXAPU_INFO("[xma] ctx {} loop jump {} -> {} (count={})", id(), loop_end, loop_start,
+                uint32_t(data->loop_count));
+  }
   data->input_buffer_read_offset = loop_start;
   loop_start_skip_pending_ = true;
 
@@ -614,6 +661,16 @@ void XmaContext::Decode(XMA_CONTEXT_DATA* data) {
     packet_info.current_frame_size_ = static_cast<uint32_t>(frame_size);
   }
 
+  if (REXCVAR_GET(xma_trace) && data->loop_count > 0 && !is_loop_end_frame) {
+    const uint32_t frame_start = data->input_buffer_read_offset;
+    const uint32_t frame_end = frame_start + packet_info.current_frame_size_;
+    if (data->loop_end > frame_start && data->loop_end < frame_end) {
+      REXAPU_INFO("[xma] ctx {} loop_end {} falls INSIDE frame {}..{} (not on a frame start) - "
+                  "loop will be missed",
+                  id(), uint32_t(data->loop_end), frame_start, frame_end);
+    }
+  }
+
   BitStream stream(current_input_buffer, (packet_index + 1) * kBitsPerPacket);
   stream.SetOffset(data->input_buffer_read_offset);
 
@@ -668,10 +725,47 @@ void XmaContext::Decode(XMA_CONTEXT_DATA* data) {
     // Loop start: skip leading subframes per loop_subframe_skip. skip == 4
     // means the whole frame is a warm-up frame (frame-aligned loop start):
     // decode seeds the codec state, output is fully discarded.
+    bool skipped_for_loop = false;
     if (loop_start_skip_pending_) {
       const uint8_t skip = data->loop_subframe_skip << data->is_stereo;
       current_frame_remaining_subframes_ -= std::min(skip, current_frame_remaining_subframes_);
       loop_start_skip_pending_ = false;
+      skipped_for_loop = true;
+    }
+
+    // Stream start/end skip carried in the frame header (encoder delay at the
+    // start of a stream, padding at its end). The XMA hardware drops these
+    // samples; FFmpeg only reports them. Output granularity is a 128-sample
+    // subframe, so round the start skip down and the end skip down as well
+    // (never drop audible samples).
+    if (REXCVAR_GET(xma_honor_stream_skip)) {
+      const AVDictionaryEntry* start_e = av_dict_get(av_frame_->metadata, "xma_start_skip", nullptr, 0);
+      const AVDictionaryEntry* end_e = av_dict_get(av_frame_->metadata, "xma_end_skip", nullptr, 0);
+      const int start_skip = start_e ? std::atoi(start_e->value) : 0;
+      const int end_skip = end_e ? std::atoi(end_e->value) : 0;
+      if (REXCVAR_GET(xma_trace) && (start_e || end_e)) {
+        REXAPU_INFO("[xma] ctx {} frame skip start={} end={} at rd={}", id(), start_skip, end_skip,
+                    uint32_t(data->input_buffer_read_offset));
+      }
+      const uint8_t per_ch = static_cast<uint8_t>(kSamplesPerFrame / kSamplesPerSubframe);  // 4
+      if (end_skip > 0 && !is_loop_end_frame) {
+        const uint8_t keep =
+            static_cast<uint8_t>(per_ch - std::min<int>(per_ch, end_skip / kSamplesPerSubframe));
+        const uint8_t limit = static_cast<uint8_t>(keep << data->is_stereo);
+        if (limit < current_frame_remaining_subframes_) {
+          // Reuse the loop-end limiter: output only the first `limit` subframes.
+          loop_frame_output_limit_ = limit ? limit : 0;
+          if (!limit) {
+            current_frame_remaining_subframes_ = 0;
+          }
+        }
+      }
+      if (start_skip > 0 && !skipped_for_loop) {
+        const uint8_t skip =
+            static_cast<uint8_t>(std::min<int>(per_ch, start_skip / kSamplesPerSubframe)
+                                 << data->is_stereo);
+        current_frame_remaining_subframes_ -= std::min(skip, current_frame_remaining_subframes_);
+      }
     }
   }
 
